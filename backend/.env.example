# Meeting-Ops Environment Configuration Example
# Copy this file to .env and update with your production values

# Security
SECRET_KEY=your-32-character-secret-key-here

# Database (PostgreSQL via Docker on port 5434)
DATABASE_URL=postgresql://meetingops:REMOVED@localhost:5434/meeting_sessions

# Redis (port 6381 via Docker - used for real-time features)
REDIS_URL=redis://localhost:6381

# LLM (llama.cpp Vulkan on port 11437 via Docker)
LLAMA_CPP_URL=http://localhost:11437

# CORS (comma-separated origins, leave empty to allow private IPs automatically)
# CORS_ORIGINS=http://192.168.1.100:7777,http://example.com

# Audio Configuration
AUDIO_SAMPLE_RATE=44100
AUDIO_DEVICE=hw:0,0

# NPU Configuration (optional - AMD Phoenix)
NPU_DEVICE_PATH=/dev/accel/accel0
NPU_MODEL=large-v3
NPU_COMPUTE_TYPE=int8

# Logging
LOG_LEVEL=INFO
DEBUG=false
