# Meeting-Ops Environment Configuration Example
# Copy this file to .env and update with your production values

# Security
SECRET_KEY=your-32-character-secret-key-here

# Database
DATABASE_URL=sqlite:///meeting_sessions.db
# For PostgreSQL: postgresql://user:REMOVED@localhost:5432/dbname

# Redis (optional, for advanced features)
REDIS_URL=redis://localhost:6379

# Audio Configuration
AUDIO_SAMPLE_RATE=44100
AUDIO_DEVICE=hw:0,0

# NPU Configuration
NPU_DEVICE_PATH=/dev/accel/accel0
NPU_MODEL=large-v3
NPU_COMPUTE_TYPE=int8

# LLM Configuration (optional)
OLLAMA_URL=http://localhost:11434
OPENAI_API_KEY=your-openai-key-here

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=person128@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=person128@example.com

# Logging
LOG_LEVEL=INFO
DEBUG=false