[Unit]
Description=Unicorn Commander Meeting-Ops Docker Stack
Documentation=https://github.com/Unicorn-Commander/Meeting-Ops
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/unicorn-commander/meeting-ops
ExecStartPre=/usr/bin/docker compose pull
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart
TimeoutStartSec=300
Restart=on-failure
RestartSec=10

# Environment file for configuration
EnvironmentFile=-/etc/unicorn-commander/meeting-ops.env

# Security settings
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target