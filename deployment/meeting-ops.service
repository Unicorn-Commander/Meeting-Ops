[Unit]
Description=Meeting-Ops Recording Appliance Backend
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=ucadmin
Group=ucadmin
WorkingDirectory=/home/ucadmin/Development/Meeting-Ops/backend

# Environment variables
Environment="DATABASE_URL=postgresql://meeting_ops:REMOVED@localhost:5432/meeting_ops"
Environment="REDIS_URL=redis://localhost:6379"
Environment="SECRET_KEY=your-secret-key-change-in-production"
Environment="NPU_DEVICE=/dev/accel/accel0"

# Pre-start: Ensure Docker services are running
ExecStartPre=/usr/bin/docker compose -f /home/ucadmin/Development/Meeting-Ops/docker-compose.yml up -d postgres redis qdrant

# Main service
ExecStart=/home/ucadmin/Development/Meeting-Ops/backend/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 9050

# Restart policy
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal

# Give access to audio devices and NPU
SupplementaryGroups=audio render

[Install]
WantedBy=multi-user.target
