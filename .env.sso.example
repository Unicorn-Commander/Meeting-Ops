# Copy to an untracked .env.sso and inject real values through protected
# deployment configuration. Never commit populated credentials.
DOMAIN=meet.example.com
ACME_EMAIL=ops@example.com

PG_USER=meeting_ops
PG_DB=meeting_ops
PG_PASS=replace-at-deploy

AUTHENTIK_SECRET_KEY=replace-at-deploy
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_DB=authentik
AUTHENTIK_PG_PASS=replace-at-deploy
AUTHENTIK_API_TOKEN=replace-at-deploy
AUTHENTIK_EMAIL_HOST=smtp.example.com
AUTHENTIK_EMAIL_PORT=587
AUTHENTIK_EMAIL_USER=replace-at-deploy
AUTHENTIK_EMAIL_PASS=replace-at-deploy
AUTHENTIK_EMAIL_TLS=true
AUTHENTIK_EMAIL_FROM=meeting-ops@example.com

TRAEFIK_LOG_LEVEL=INFO

AZURE_CLIENT_ID=replace-at-deploy
AZURE_CLIENT_SECRET=replace-at-deploy
AZURE_TENANT_ID=replace-at-deploy
GOOGLE_CLIENT_ID=replace-at-deploy
GOOGLE_CLIENT_SECRET=replace-at-deploy
GITHUB_CLIENT_ID=replace-at-deploy
GITHUB_CLIENT_SECRET=replace-at-deploy

LDAP_SERVER_URI=ldaps://ldap.example.com:636
LDAP_BIND_DN=cn=meeting-ops,ou=service-accounts,dc=example,dc=com
LDAP_BIND_PASSWORD=replace-at-deploy
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_DN=ou=users,dc=example,dc=com
LDAP_GROUP_DN=ou=groups,dc=example,dc=com
